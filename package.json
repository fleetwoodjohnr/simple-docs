{
  "name": "simple-docs",
  "productName": "Simple Docs",
  "version": "0.1.0",
  "description": "A fast, modern word processor and document editor",
  "main": "out/main/index.js",
  "author": "Simple Docs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
